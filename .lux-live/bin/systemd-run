#!/bin/bash
# Records the unit the helper asked to start. Does not run upgrade.sh.
record="${LUX_SYSTEMD_RECORD:-/tmp/systemd-run-args.txt}"
{
  echo "----"
  printf '%s\n' "$@"
} >> "$record"
script=""
for arg in "$@"; do
  case "$arg" in
    --setenv=LUX_UPGRADE_SCRIPT=*) script="${arg#--setenv=LUX_UPGRADE_SCRIPT=}" ;;
  esac
done
if [[ -n "$script" && -f "$script" ]]; then
  {
    echo "SCRIPT_PATH=$script"
    echo "SCRIPT_UID=$(stat -c %u "$script")"
    echo "SCRIPT_MODE=$(stat -c %a "$script")"
    if grep -q RAN_CHECKOUT "$script"; then echo "HAS_MARKER=yes"; else echo "HAS_MARKER=no"; fi
  } >> "$record"
fi
exit 0
