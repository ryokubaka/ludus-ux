# ─────────────────────────────────────────────────────────────────
# Ludus UX — copy to .env and fill in your values. See docs/getting-started.md.
# ─────────────────────────────────────────────────────────────────

# ── Authentication ──────────────────────────────────────────────
# Ludus server hostname or IP (SSH login, GOAD, and compose builds LUDUS_* URLs from this).
LUDUS_SSH_HOST=192.168.0.100
LUDUS_SSH_PORT=22

# If the hostname only resolves on the Docker host (VPN, hosts file, lab DNS), set the IP.
# The container adds hostname→IP to /etc/hosts at startup.
# LUDUS_SERVER_IP=192.168.1.100

# Session cookies — use a long random value (e.g. openssl rand -hex 32). Required in production (min 32 chars, no placeholders).
APP_SECRET=change-me-to-a-random-secret-string-32-chars

# When true, Ludus, PocketBase, and Proxmox HTTPS skip certificate checks.
# GitHub and other HTTPS stay verified. Unset verifies; before 1.5.0 unset meant true.
# Set true only for a lab whose Ludus or Proxmox certificate is self-signed.
# LUDUS_TLS_INSECURE=true

# Optional pin for the Ludus SSH host key: the SHA256: fingerprint as
# `ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub` prints it, the public key
# line, or a known_hosts line. When unset, the first key seen is stored and a
# later change is rejected (an admin can forget it in Settings → Auth).
# LUX_SSH_HOST_KEY=

# When set, an in-app upgrade verifies the tag in a keyring that contains only
# this public key file. The path is on the Docker host (the switch runs there).
# Leave unset to keep the previous checkout behavior.
# LUX_UPGRADE_TRUSTED_KEY=/opt/lux/release-key.asc
# Optional primary-key fingerprint. A signing subkey still matches.
# LUX_UPGRADE_TRUSTED_FPR=
# LUX_USE_LUDUS_HOST_DNS=false

# Max duration for deploy log SSE streams (milliseconds). Default: 1800000 (30 min).
# LOG_STREAM_MAX_MS=1800000

# IANA timezone for Node and nginx containers (default if unset: America/New_York)
TZ=America/New_York

# When "1", browser console logs JSON for Ludus→GOAD pipeline (rebuild after change).
# NEXT_PUBLIC_LUX_GOAD_CHAIN_DEBUG=1

# ── Ludus API ────────────────────────────────────────────────────
# docker-compose sets these from LUDUS_SSH_HOST unless you define overrides here.
# Uncomment to force explicit URLs (otherwise compose defaults apply at `docker compose up`).
# LUDUS_URL=https://${LUDUS_SSH_HOST}:8080
# A default Ludus install binds 8081 to 127.0.0.1. Use the SSH tunnel:
# LUDUS_ADMIN_URL=https://127.0.0.1:18081
# Use the host address only after 8081 accepts connections from the container:
# LUDUS_ADMIN_URL=https://${LUDUS_SSH_HOST}:8081

# Required for Ludus v2 admin features (users, ranges, etc.). On server: /opt/ludus/install/root-api-key
LUDUS_ROOT_API_KEY=

# Host SSH — Ludus runs on the Proxmox host. Prefer a private key
# (default ./ssh → /app/ssh); leave PROXMOX_SSH_PASSWORD empty when using a key.
# PROXMOX_SSH_USER is root, or another account allowed to run
# sudo -n /usr/local/sbin/lux-host (quickstart offers this rule; it is not NOPASSWD: ALL).
# docs/getting-started.md + docs/ssh-and-auth.md
PROXMOX_SSH_USER=root
PROXMOX_SSH_PASSWORD=
# Path inside the container (matches ./ssh/id_rsa on the host by default)
PROXMOX_SSH_KEY_PATH=/app/ssh/id_rsa
# PROXMOX_SSH_KEY_PASSPHRASE=

# ── TLS (bundled nginx in docker-compose) ─────────────────────────
# docker-compose.yml serves HTTPS on host :443 via nginx; certs live under docker/nginx/certificates/
# (cert.pem + key.pem). The ludus-ux app listens on plain HTTP :3000 inside the network.
# Compose defaults: DISABLE_HTTPS=true, TRUST_PROXY_TLS=true (secure cookies / HSTS still apply).
# Override only if you run without nginx or use npm run dev — see docs/environment.md.
# DISABLE_HTTPS=false
# TRUST_PROXY_TLS=false
# CN/SAN hints when nginx auto-generates a self-signed cert (optional)
# TLS_HOSTNAME=

# ── GOAD ─────────────────────────────────────────────────────────
# false hides GOAD in the UI (can also toggle in Settings while running)
ENABLE_GOAD=true
# Path to GOAD on the Ludus server (must match the server layout)
GOAD_PATH=/opt/GOAD
# Optional; same key as PROXMOX_SSH_KEY_PATH unless you need a separate file
# GOAD_SSH_KEY_PATH=/app/ssh/id_rsa

# ── LudusHound ───────────────────────────────────────────────────
# false hides LudusHound in the UI (can also toggle in Settings while running)
ENABLE_LUDUSHOUND=true
# Path to cloned LudusHound repo on the Ludus server (operator clones; LUX builds/installs)
LUDUSHOUND_PATH=/opt/LudusHound

# ── Sources auto-sync ────────────────────────────────────────────
# LUX re-pulls registered git Ludus sources on an interval + when a catalog
# view is stale, so Update available / Re-sync see tip content without a
# manual Sync click. Set SOURCE_AUTO_SYNC_ENABLED=false to disable.
# SOURCE_AUTO_SYNC_ENABLED=true
# Interval in ms (default 300000 = 5 minutes; minimum 60000).
# SOURCE_AUTO_SYNC_INTERVAL_MS=300000

# ── Docker Compose volumes (host paths) ────────────────────────
# Directory on the LUX host for the PROXMOX_SSH_USER private key. See docs/ssh-and-auth.md.
SSH_KEY_PATH=./ssh

# Image user, passed into the Dockerfile at build time. Pick a uid and gid that
# `getent passwd` and `getent group` do not already list on this host, then
# `chown` ./ssh/id_rsa to that pair. Changing these needs:
#   docker compose up -d --build
# Do not set Compose user:. The entrypoint starts as root, then drops to this user.
LUX_UID=64532
LUX_GID=64532
# SQLite, uploads, task logs
# DATA_DIR=./data

# Optional override for Settings → About upgrade/downgrade when auto-discovery fails.
# Use a path valid on the Docker *host* (where compose runs), not inside the container.
# On Linux: /opt/ludus-ux. On Docker Desktop, leave empty so the host probe resolves
# the bind mount via docker inspect (do not set a Windows E:\ path here).
# LUX_REPO_PATH=/opt/ludus-ux

# Optional GitHub PAT for Settings → About release list (avoids unauthenticated 403).
# GITHUB_TOKEN=
