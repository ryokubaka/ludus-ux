# LUX host SSH. Passwordless sudo for /usr/local/sbin/lux-host only.
# This is not NOPASSWD: ALL. Other sudo commands still require a password.
#
# The helper does not run a shell. Allowed operations are listed in
# /usr/local/sbin/lux-host (pvesh, qm, chpasswd, packer files, ansible home,
# GOAD workspace ownership, range logs).
Cmnd_Alias LUX_HOST = /usr/local/sbin/lux-host
# Debian 13 sudo allocates a pty by default and drops an SSH pipe. The helper
# reads self-update and other bodies on stdin.
Defaults!LUX_HOST !use_pty
__LUX_SSH_USER__ ALL=(root) NOPASSWD: LUX_HOST
